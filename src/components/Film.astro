---
import Icon from './Icon.astro';
interface Props { kind: 'suite' | 'phone' | 'message' | 'contact'; title: string; description: string; }
const { kind, title, description } = Astro.props;
const duration = kind === 'suite' ? '48 seconds' : '28 seconds';
const transcripts = {
  suite: 'An instrumental teaser introduces No Call, No Message and No Contact in phone mockups. Edited app screens show audio-call controls and a fictional calling portrait, a message inbox and conversation, a contact directory and details, plus appearance and accessibility settings. The closing composition brings the three independent apps together.',
  phone: 'An instrumental teaser introduces No Call through edited app screens inside phone mockups. It shows a fictional calling portrait, call history, contact details, and appearance and accessibility controls. A video-call interface is a simulated preview; live carrier video is experimental and unverified.',
  message: 'An instrumental teaser presents No Message in phone mockups. Edited screens show the inbox, a fictional conversation, a pending scheduled SMS and settings. Headlines introduce categories, search, Saved Messages, optional message islands and recognised-code copy. SMS uses the carrier; scheduling does not promise exact delivery. MMS and RCS are not promoted as available services.',
  contact: 'An instrumental teaser presents No Contact in phone mockups. Edited screens show the directory, favourites, contact details, the editor and backup settings. Headlines introduce regular contact photos, separate calling portraits, and VCF/CSV transfer. Backup formats have different coverage; the film does not promise a lossless complete backup through CSV.',
};
---
<section class="film-section" id="film" aria-labelledby="film-title">
  <div class="section-heading"><h2 id="film-title">{title}</h2><span class="quiet">{duration} / Sound on if you like</span></div>
  <figure class="film">
    <video controls playsinline preload="none" poster={`/media/${kind}-poster.webp`} aria-label={title} aria-describedby="film-description">
      <source src={`/media/${kind}-pilot-1080p.mp4`} type="video/mp4" />
      <track kind="captions" srclang="en" label="English" src={`/media/${kind}-captions.vtt`} default />
      Your browser does not support embedded video. <a href={`/media/${kind}-pilot-1080p.mp4`}>Open the film</a>.
    </video>
    <figcaption id="film-description"><span><Icon name="play" size={16} /> {description}</span><a href={`/media/${kind}-pilot-1080p.mp4`} download>Save the film <Icon name="arrow" size={16} /></a></figcaption>
  </figure>
  <details class="film-transcript"><summary>Read a description of the film</summary><p>{transcripts[kind]} All identities and conversations are fictional. There is no spoken narration.</p></details>
</section>
